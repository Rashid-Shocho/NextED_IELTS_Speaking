+def _transcode_to_wav_bytes(input_path: Path) -> bytes:
+    """
+    RunPod's handler (and the check just above this call site) only accepts
+    wav/mp3/m4a/ogg/flac -- browser MediaRecorder output (webm/opus) isn't
+    in that list. Rather than rejecting it, transcode to a standard 16kHz
+    mono WAV with the same ffmpeg binary VAD already depends on (see
+    vad.py's _decode_to_pcm16_mono_16k for the same pattern).
+    """
+    proc = subprocess.run(
+        [
+            settings.FFMPEG_PATH,
+            "-nostdin",
+            "-hide_banner",
+            "-loglevel", "warning",
+            "-i", str(input_path),
+            "-map", "0:a:0",
+            "-vn",
+            "-ac", "1",
+            "-ar", "16000",
+            "-f", "wav",
+            "-acodec", "pcm_s16le",
+            "pipe:1",
+        ],
+        capture_output=True,
+    )
+    if proc.returncode != 0:
+        stderr_text = proc.stderr.decode(errors="ignore") if proc.stderr else ""
+        raise RuntimeError(f"ffmpeg transcode to wav failed: {stderr_text[-800:]}")
+    if not proc.stdout:
+        raise RuntimeError("ffmpeg transcode produced no output")
+    return proc.stdout
+
