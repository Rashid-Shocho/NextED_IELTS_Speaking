DATABASE_URL=postgresql://user:password@host:5432/dbname
GROQ_API_KEY=
HF_TOKEN=

# RunPod pronunciation endpoint (wav2vec2-lv-60-espeak-cv-ft + forced_align)
RUNPOD_API_KEY=
RUNPOD_PRONUNCIATION_URL=https://api.runpod.ai/v2/xleyv5ilspgpbp/runsync

# Shared secret the Next.js app sends as X-Internal-Api-Key on every
# request to this service. Generate any long random string, e.g.:
#   openssl rand -hex 32
# and put the SAME value in the Next.js app's SPEAKING_API_KEY.
INTERNAL_API_KEY=

# Cloudflare R2 (S3-compatible) -- optional. If left blank, audio archival
# to R2 is skipped entirely and speaking_training_samples simply won't get
# populated -- everything else keeps working exactly as before.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain, or the bucket's public r2.dev URL (enable in Cloudflare
# dashboard -> R2 -> bucket -> Settings -> Public Access). No trailing slash.
R2_PUBLIC_BASE_URL=
